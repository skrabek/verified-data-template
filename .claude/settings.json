{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./raw/**)",
      "Write(./raw/**)",
      "Edit(./releases/**)",
      "Write(./releases/**)",
      "Edit(./decisions/**)",
      "Write(./decisions/**)"
    ]
  }
}
